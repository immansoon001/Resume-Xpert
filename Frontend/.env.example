# API base URL for Frontend
# In local development: http://localhost:3000
# In production (e.g. Vercel dashboard): URL of your deployed backend (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:3000

# Clerk Authentication Publishable Key (From https://dashboard.clerk.com)
# Example: pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
